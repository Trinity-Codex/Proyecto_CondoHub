# Entorno virtual de Python (cada uno crea el suyo)
venv/
.venv/

# Configuración local con claves (cada uno tiene su .env; el modelo es .env.example)
.env

# Archivos compilados de Python
__pycache__/
*.pyc

# Base de datos SQLite de pruebas (USE_SQLITE=1)
db.sqlite3

# Archivos estáticos recolectados para producción (collectstatic)
staticfiles/

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Registros
*.log

# Informe 1 (material de la evaluacion, no se sube al repositorio)
docs/Informe 1/

# Analisis de la competencia (resume datos simulados del cliente; no se sube al repositorio)
docs/analisis_competencia/

# Claude Code: archivos propios de cada PC
# (.claude/rules/ no se ignora: queda abierto a compartirse más adelante)
.claude/settings.local.json
.claude/worktrees/
# Los regenera "openspec init --tools claude" en cada PC
.claude/commands/opsx/
.claude/skills/openspec-*/
