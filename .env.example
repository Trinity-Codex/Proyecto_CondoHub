# ============================================================================
# Configuración local de CondoHub.
# 1) Copia este archivo y nómbralo ".env" (en la misma carpeta que manage.py).
# 2) Ajusta los valores si tu MySQL es distinto.
# El archivo .env NO se sube a GitHub (está en .gitignore): cada uno tiene el suyo.
# ============================================================================

# --- Base de datos MySQL 8 ---
# Usuario y base que crea el script docs/crear_base_datos.sql
DB_NAME=condohub
DB_USER=condohub
DB_PASSWORD=condohub_dev
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Django ---
# 1 = modo desarrollo (errores detallados). En un servidor real: 0
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En producción, una clave larga y secreta:
# DJANGO_SECRET_KEY=

# 1 = usar SQLite en vez de MySQL (solo para probar rápido sin MySQL)
USE_SQLITE=0
